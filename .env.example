EMBED_MODE=hash
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=cloudrag
DB_USER=raguser
DB_PASSWORD=local-classroom-password-change-me

# Opsional semantic: model 384 dimensi. Untuk dokumen Indonesia coba
# EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Opsional: generasi LLM server-side. Cek model aktif dan biaya sebelum dipakai.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Atau endpoint OpenAI-compatible lain (prioritas di atas Groq bila diisi), mis. Ollama lokal tanpa key:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=hf.co/bartowski/Qwen2.5-1.5B-Instruct-GGUF:Q4_K_M
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# SESUAIKAN DI DEVICE-MU: batas tunggu LLM (detik, default 30). CPU lambat + model 3B -> naikkan ke 60-90.
# Bila LLM mati/timeout, API tetap menjawab ekstraktif dengan mode "extractive-fallback".
LLM_TIMEOUT_S=
